# ==========================================
# Gatherly AI - Environment Configuration
# ==========================================

# Server-side Gemini API Key (Optional)
# If omitted or invalid, Gatherly AI seamlessly operates in Deterministic Demo Mode.
GEMINI_API_KEY=

# Supported Gemini Model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Base URL for metadata / SEO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate Limiting (Requests per IP per minute)
RATE_LIMIT_PER_MINUTE=20
